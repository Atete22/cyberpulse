from PIL import Image, ImageDraw, ImageFont

# 1. Create a crisp, attractive 800x500 (16:10) cover.png for Neon Relic Runner
w, h = 800, 500
img = Image.new("RGB", (w, h), "#0b0f19")
draw = ImageDraw.Draw(img)

# Background grid & glow effect
for x in range(0, w, 40):
    draw.line([(x, 0), (x, h)], fill="#131c31", width=1)
for y in range(0, h, 40):
    draw.line([(0, y), (w, y)], fill="#131c31", width=1)

# Glowing cyber circles
draw.ellipse([260, 110, 540, 390], outline="#1e293b", width=4)
draw.ellipse([300, 150, 500, 350], outline="#38bdf8", width=3)

# Draw stylized character in center
cx, cy = 400, 260
# Legs
draw.rectangle([cx - 18, cy + 20, cx - 4, cy + 50], fill="#a855f7")
draw.rectangle([cx + 4, cy + 20, cx + 18, cy + 50], fill="#a855f7")
# Torso
draw.polygon([(cx - 22, cy - 16), (cx + 22, cy - 16), (cx + 28, cy + 24), (cx - 28, cy + 24)], fill="#38bdf8")
# Head
draw.ellipse([cx - 22, cy - 58, cx + 22, cy - 14], fill="#8d5524")
# Hair (braids)
draw.rectangle([cx - 22, cy - 60, cx + 22, cy - 46], fill="#1e293b")
draw.rectangle([cx - 26, cy - 50, cx - 18, cy - 18], fill="#1e293b")
draw.rectangle([cx + 18, cy - 50, cx + 26, cy - 18], fill="#1e293b")
# Crown
draw.polygon([(cx - 20, cy - 58), (cx - 20, cy - 76), (cx - 10, cy - 66), (cx, cy - 80), (cx + 10, cy - 66), (cx + 20, cy - 76), (cx + 20, cy - 58)], fill="#facc15")

# Draw glowing blue relics & red drones around character
for rx, ry in [(220, 180), (580, 190), (250, 340), (560, 330)]:
    draw.ellipse([rx - 14, ry - 14, rx + 14, ry + 14], fill="#38bdf8", outline="#bae6fd", width=3)

for dx, dy in [(160, 260), (640, 250)]:
    draw.ellipse([dx - 18, dy - 18, dx + 18, dy + 18], fill="#f43f5e", outline="#fecdd3", width=3)

# Banner text box at top and bottom
draw.rectangle([180, 28, 620, 88], fill="#0f172a", outline="#38bdf8", width=2)
draw.text((255, 48), "NEON RELIC RUNNER", fill="#38bdf8")

draw.rectangle([250, 420, 550, 465], fill="#0f172a", outline="#a855f7", width=2)
draw.text((310, 436), "PLAY ON START.NG", fill="#f8fafc")

img.save("cover.png")

# 2. Save the ready-to-play index.html file
html_content = """<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Neon Relic Runner · start.ng</title>
  <link rel="icon" href="./cover.png" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }
    body {
      background: #0b0f19;
      color: #f8fafc;
      font-family: system-ui, -apple-system, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      overflow: hidden;
    }
    #hud {
      width: 100%;
      max-width: 800px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 16px;
      background: rgba(15, 23, 42, 0.9);
      border: 1px solid #1e293b;
      border-radius: 12px 12px 0 0;
    }
    .profile-card {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .profile-card img {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 2px solid #38bdf8;
      background: #1e293b;
      display: none;
    }
    .player-meta { font-size: 14px; line-height: 1.2; }
    .player-name { font-weight: 700; color: #f1f5f9; }
    .player-handle { font-size: 12px; color: #94a3b8; }
    .btn {
      background: #38bdf8;
      color: #0f172a;
      border: none;
      padding: 7px 14px;
      border-radius: 8px;
      font-weight: 700;
      cursor: pointer;
      font-size: 13px;
    }
    .btn:hover { background: #7dd3fc; }
    #game-wrap {
      position: relative;
      width: 100%;
      max-width: 800px;
      aspect-ratio: 16 / 10;
      border: 1px solid #1e293b;
      border-top: none;
      border-radius: 0 0 12px 12px;
      overflow: hidden;
      background: radial-gradient(circle at center, #1e293b 0%, #090d16 100%);
    }
    canvas { width: 100%; height: 100%; display: block; }
    #overlay {
      position: absolute;
      inset: 0;
      background: rgba(9, 13, 22, 0.84);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      padding: 20px;
      text-align: center;
    }
    #leaderboard-box {
      background: rgba(15, 23, 42, 0.9);
      border: 1px solid #334155;
      border-radius: 8px;
      padding: 10px 14px;
      width: 100%;
      max-width: 360px;
      font-size: 13px;
      max-height: 160px;
      overflow-y: auto;
    }
    .lb-row {
      display: flex;
      justify-content: space-between;
      padding: 4px 6px;
      border-bottom: 1px solid #1e293b;
    }
    .lb-row.me {
      background: rgba(56, 189, 248, 0.2);
      color: #38bdf8;
      font-weight: 700;
    }
  </style>
</head>
<body>

  <div id="hud">
    <div class="profile-card">
      <img id="player-face" alt="Player avatar" />
      <div class="player-meta">
        <div class="player-name" id="player-name">Loading character...</div>
        <div class="player-handle" id="player-handle">@guest</div>
      </div>
    </div>
    <div style="display:flex; align-items:center; gap:14px;">
      <div style="font-weight:700; font-size:16px;">Score: <span id="score-val">0</span></div>
      <button id="signin-btn" class="btn" style="display:none;">Sign in with start.ng</button>
    </div>
  </div>

  <div id="game-wrap">
    <canvas id="canvas" width="800" height="500"></canvas>
    <div id="overlay">
      <h1 style="font-size:28px; color:#38bdf8;">Neon Relic Runner</h1>
      <p style="color:#cbd5e1; font-size:14px; max-width:440px;">
        Move your <strong>start.ng character</strong> with Arrow Keys, WASD, or Touch/Mouse. Collect glowing relics and dodge red drones!
      </p>
      <div id="leaderboard-box">Loading leaderboard...</div>
      <div style="display:flex; gap:10px;">
        <button id="start-btn" class="btn">Play Now</button>
        <button id="overlay-signin-btn" class="btn" style="display:none; background:#a855f7; color:#fff;">Sign In to Save Scores</button>
      </div>
    </div>
  </div>

  <script>
    const START_NG = 'https://start.ng';
    const connectFrame = document.createElement('iframe');
    connectFrame.src = `${START_NG}/connect`;
    connectFrame.style.display = 'none';
    document.body.appendChild(connectFrame);

    let frameReady = new Promise((resolve) => {
      connectFrame.addEventListener('load', () => resolve(), { once: true });
      setTimeout(resolve, 1500);
    });

    function askStartNg(payload, expectedType, timeoutMs = 2500) {
      return new Promise(async (resolve) => {
        await frameReady;
        let done = false;
        const timer = setTimeout(() => {
          if (!done) { done = true; window.removeEventListener('message', onMsg); resolve(null); }
        }, timeoutMs);

        function onMsg(e) {
          if (e.origin !== START_NG) return;
          if (e.data && e.data.type === expectedType) {
            done = true;
            clearTimeout(timer);
            window.removeEventListener('message', onMsg);
            resolve(e.data);
          }
        }
        window.addEventListener('message', onMsg);
        if (connectFrame.contentWindow) {
          connectFrame.contentWindow.postMessage(payload, START_NG);
        }
      });
    }

    function signInWithStartNg() {
      location.href = `${START_NG}/?return_to=${encodeURIComponent(location.origin + location.pathname)}`;
    }

    document.getElementById('signin-btn').addEventListener('click', signInWithStartNg);
    document.getElementById('overlay-signin-btn').addEventListener('click', signInWithStartNg);

    let currentPlayer = {
      id: null,
      name: 'Guest',
      account: 'guest',
      isGuest: true,
      face: null,
      style: {
        body: 'female',
        primaryColor: '#38bdf8',
        secondaryColor: '#a855f7',
        skinColor: '#8d5524',
        hairColor: '#1e293b',
        hair: 'braids',
        hat: 'none',
        accessory: 'none'
      }
    };

    const urlHasGuest = new URLSearchParams(location.search).has('guest');

    async function initStartNg() {
      const reply = await askStartNg({ type: 'startng:whoami' }, 'startng:user');
      const raw = reply?.user ?? reply?.guest;
      const isSignedIn = Boolean(reply?.user);

      if (raw) {
        currentPlayer = {
          id: raw.id || null,
          name: raw.name || (isSignedIn ? 'Player' : 'Guest'),
          account: raw.account || (isSignedIn ? 'player' : 'guest'),
          isGuest: !isSignedIn,
          face: raw.face || null,
          style: Object.assign({}, currentPlayer.style, raw.style || {})
        };
      }

      document.getElementById('player-name').textContent = currentPlayer.name;
      document.getElementById('player-handle').textContent = `@${currentPlayer.account}`;

      if (currentPlayer.face) {
        const img = document.getElementById('player-face');
        img.src = currentPlayer.face;
        img.style.display = 'block';
      }

      if (currentPlayer.isGuest) {
        document.getElementById('signin-btn').style.display = 'inline-block';
        if (!urlHasGuest) {
          document.getElementById('overlay-signin-btn').style.display = 'inline-block';
        }
      }

      await loadLeaderboard();
    }

    async function loadLeaderboard() {
      const box = document.getElementById('leaderboard-box');
      const board = await askStartNg({ type: 'startng:leaderboard', limit: 10 }, 'startng:leaderboardData');
      const rows = board?.entries || board?.leaderboard || board?.rows || [];
      if (!rows.length) {
        box.innerHTML = '<div style="color:#94a3b8;">No runs recorded yet. Be the first on the board!</div>';
        return;
      }
      box.innerHTML = rows.map((r, idx) => {
        const isMe = currentPlayer.id && (r.player_id === currentPlayer.id || r.id === currentPlayer.id);
        return `<div class="lb-row ${isMe ? 'me' : ''}">
          <span>#${idx + 1} ${r.name || r.account || 'Player'}</span>
          <span>${r.score ?? 0} pts</span>
        </div>`;
      }).join('');
    }

    function drawCharacter(ctx, x, y, style) {
      const s = style || currentPlayer.style;
      ctx.save();
      ctx.translate(x, y);

      ctx.fillStyle = s.secondaryColor || '#a855f7';
      ctx.fillRect(-10, 10, 8, 14);
      ctx.fillRect(2, 10, 8, 14);

      ctx.fillStyle = s.primaryColor || '#38bdf8';
      ctx.beginPath();
      if (s.body === 'female') {
        ctx.moveTo(-11, -8);
        ctx.lineTo(11, -8);
        ctx.lineTo(14, 12);
        ctx.lineTo(-14, 12);
      } else {
        ctx.rect(-13, -8, 26, 20);
      }
      ctx.closePath();
      ctx.fill();

      ctx.fillStyle = s.skinColor || '#c68642';
      ctx.beginPath();
      ctx.arc(0, -18, 12, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#0f172a';
      ctx.fillRect(-5, -20, 3, 3);
      ctx.fillRect(2, -20, 3, 3);

      if (s.hair && s.hair !== 'bald') {
        ctx.fillStyle = s.hairColor || '#1e293b';
        if (s.hair === 'afro') {
          ctx.beginPath();
          ctx.arc(0, -23, 16, 0, Math.PI * 2);
          ctx.fill();
        } else if (s.hair === 'bun' || s.hair === 'ponytail') {
          ctx.fillRect(-12, -30, 24, 7);
          ctx.beginPath();
          ctx.arc(s.hair === 'bun' ? 0 : 14, -33, 6, 0, Math.PI * 2);
          ctx.fill();
        } else if (s.hair === 'braids' || s.hair === 'dreads') {
          ctx.fillRect(-12, -30, 24, 7);
          ctx.fillRect(-14, -24, 4, 16);
          ctx.fillRect(10, -24, 4, 16);
        } else {
          ctx.fillRect(-12, -30, 24, 8);
        }
      }

      if (s.hat && s.hat !== 'none') {
        if (s.hat === 'crown') {
          ctx.fillStyle = '#facc15';
          ctx.beginPath();
          ctx.moveTo(-12, -28);
          ctx.lineTo(-12, -38);
          ctx.lineTo(-5, -32);
          ctx.lineTo(0, -40);
          ctx.lineTo(5, -32);
          ctx.lineTo(12, -38);
          ctx.lineTo(12, -28);
          ctx.closePath();
          ctx.fill();
        } else if (s.hat === 'tophat') {
          ctx.fillStyle = '#1e293b';
          ctx.fillRect(-16, -30, 32, 4);
          ctx.fillRect(-10, -46, 20, 16);
        } else {
          ctx.fillStyle = s.primaryColor || '#ef4444';
          ctx.fillRect(-13, -34, 26, 7);
        }
      }

      if (s.accessory && s.accessory !== 'none') {
        ctx.strokeStyle = '#facc15';
        ctx.lineWidth = 2;
        ctx.strokeRect(-8, -22, 7, 5);
        ctx.strokeRect(1, -22, 7, 5);
      }

      ctx.restore();
    }

    const canvas = document.getElementById('canvas');
    const ctx = canvas.getContext('2d');
    let running = false;
    let score = 0;
    const hero = { x: 400, y: 250, speed: 5 };
    const keys = {};
    let pointer = null;
    let relics = [];
    let drones = [];

    window.addEventListener('keydown', (e) => keys[e.key.toLowerCase()] = true);
    window.addEventListener('keyup', (e) => keys[e.key.toLowerCase()] = false);
    canvas.addEventListener('pointerdown', (e) => updatePointer(e));
    canvas.addEventListener('pointermove', (e) => { if (e.buttons) updatePointer(e); });
    canvas.addEventListener('pointerup', () => pointer = null);

    function updatePointer(e) {
      const rect = canvas.getBoundingClientRect();
      pointer = {
        x: (e.clientX - rect.left) * (canvas.width / rect.width),
        y: (e.clientY - rect.top) * (canvas.height / rect.height)
      };
    }

    function spawnRelic() {
      relics.push({
        x: 40 + Math.random() * (canvas.width - 80),
        y: 40 + Math.random() * (canvas.height - 80),
        r: 9
      });
    }

    function spawnDrone() {
      const edge = Math.floor(Math.random() * 4);
      let x = edge === 0 ? 0 : edge === 1 ? canvas.width : Math.random() * canvas.width;
      let y = edge === 2 ? 0 : edge === 3 ? canvas.height : Math.random() * canvas.height;
      const angle = Math.atan2(hero.y - y, hero.x - x);
      const spd = 2.2 + Math.min(score * 0.05, 3.5);
      drones.push({ x, y, vx: Math.cos(angle) * spd, vy: Math.sin(angle) * spd, r: 11 });
    }

    function startGame() {
      score = 0;
      document.getElementById('score-val').textContent = '0';
      hero.x = 400; hero.y = 250;
      relics = []; drones = [];
      for (let i = 0; i < 4; i++) spawnRelic();
      running = true;
      document.getElementById('overlay').style.display = 'none';
      requestAnimationFrame(loop);
    }

    async function endGame() {
      running = false;
      document.getElementById('overlay').style.display = 'flex';
      if (!currentPlayer.isGuest && score > 0) {
        await askStartNg({ type: 'startng:score', score }, 'startng:scoreSaved');
      }
      await loadLeaderboard();
    }

    let frame = 0;
    function loop() {
      if (!running) return;
      frame++;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      if (keys['arrowleft'] || keys['a']) hero.x -= hero.speed;
      if (keys['arrowright'] || keys['d']) hero.x += hero.speed;
      if (keys['arrowup'] || keys['w']) hero.y -= hero.speed;
      if (keys['arrowdown'] || keys['s']) hero.y += hero.speed;
      if (pointer) {
        const dx = pointer.x - hero.x, dy = pointer.y - hero.y;
        const d = Math.hypot(dx, dy);
        if (d > 4) { hero.x += (dx / d) * hero.speed; hero.y += (dy / d) * hero.speed; }
      }
      hero.x = Math.max(20, Math.min(canvas.width - 20, hero.x));
      hero.y = Math.max(35, Math.min(canvas.height - 25, hero.y));

      if (frame % 75 === 0) spawnDrone();

      ctx.fillStyle = '#38bdf8';
      relics = relics.filter((rel) => {
        ctx.beginPath();
        ctx.arc(rel.x, rel.y, rel.r, 0, Math.PI * 2);
        ctx.fill();
        if (Math.hypot(hero.x - rel.x, hero.y - rel.y) < 26) {
          score += 10;
          document.getElementById('score-val').textContent = score;
          spawnRelic();
          return false;
        }
        return true;
      });

      ctx.fillStyle = '#f43f5e';
      for (const d of drones) {
        d.x += d.vx; d.y += d.vy;
        ctx.beginPath();
        ctx.arc(d.x, d.y, d.r, 0, Math.PI * 2);
        ctx.fill();
        if (Math.hypot(hero.x - d.x, hero.y - d.y) < 24) {
          endGame();
          return;
        }
      }

      drawCharacter(ctx, hero.x, hero.y, currentPlayer.style);
      requestAnimationFrame(loop);
    }

    document.getElementById('start-btn').addEventListener('click', startGame);
    initStartNg();
  </script>
</body>
</html>
"""

with open("index.html", "w", encoding="utf-8") as f:
    f.write(html_content)

print("Generated index.html and cover.png successfully.")